# Copy this file to .env and fill in the values.

# --- LLM Provider (pick one) ---
# Option 1 - Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=

# Option 2 - Google Gemini (free tier): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Option 3 - Ollama (local, no key needed)
OLLAMA_HOST=http://localhost:11434

# Option 4 - OpenAI (paid)
OPENAI_API_KEY=

# --- Neo4j AuraDB (free tier: https://neo4j.com/cloud/aura-free/) ---
# Leave blank to use in-memory NetworkX graph only.
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# --- Optional API protection ---
KG_RATE_LIMIT_PER_MINUTE=20
API_KEY=
